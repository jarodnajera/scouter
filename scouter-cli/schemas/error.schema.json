{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hardhat:error-report:1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "toolVersion": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "error-report"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "authorization": {
      "type": "string",
      "enum": [
        "none"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "toolVersion",
    "kind",
    "code",
    "message",
    "authorization"
  ],
  "additionalProperties": false
}
