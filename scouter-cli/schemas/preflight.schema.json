{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hardhat:preflight:1.1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.1.0"
      ]
    },
    "toolVersion": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "preflight-report"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "live-preflight"
      ]
    },
    "authorization": {
      "type": "string",
      "enum": [
        "none"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "review",
        "unsupported"
      ]
    },
    "checkedAt": {
      "type": "string",
      "maxLength": 8192
    },
    "projectRoot": {
      "type": "string",
      "maxLength": 8192
    },
    "operation": {
      "type": "string",
      "enum": [
        "resolution",
        "locked-install",
        "runner"
      ]
    },
    "intendedManager": {
      "type": "string",
      "maxLength": 8192
    },
    "managerSignals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manager": {
            "type": "string",
            "maxLength": 8192
          },
          "source": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "manager",
          "source"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "nodeVersion": {
          "type": "string",
          "maxLength": 8192
        },
        "npmVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "npmCli": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "platform": {
          "type": "string",
          "maxLength": 8192
        },
        "arch": {
          "type": "string",
          "maxLength": 8192
        },
        "qualified": {
          "type": "boolean"
        },
        "supportStatus": {
          "type": "string",
          "enum": [
            "validated",
            "experimental",
            "unsupported"
          ]
        }
      },
      "required": [
        "nodeVersion",
        "npmVersion",
        "npmCli",
        "platform",
        "arch",
        "qualified",
        "supportStatus"
      ],
      "additionalProperties": false
    },
    "protectionMode": {
      "type": "string",
      "enum": [
        "native",
        "manual-required",
        "unknown"
      ]
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 8192
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "source": {
            "type": "string",
            "maxLength": 8192
          },
          "supported": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "value",
          "source",
          "supported"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "maxLength": 8192
          },
          "display": {
            "type": "string",
            "maxLength": 8192
          },
          "source": {
            "type": "string",
            "maxLength": 8192
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "display",
          "source",
          "public"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "cutoff": {
      "type": "object",
      "properties": {
        "effectiveBefore": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "meetsSevenDayPolicy": {
          "type": "boolean"
        },
        "exclusionsPresent": {
          "type": "boolean"
        }
      },
      "required": [
        "effectiveBefore",
        "source",
        "meetsSevenDayPolicy",
        "exclusionsPresent"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 8192
          },
          "scope": {
            "type": "string",
            "enum": [
              "context",
              "protections"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "code",
          "scope",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "inputDigests": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "lockfile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        },
        "relevantConfig": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        }
      },
      "required": [
        "manifest",
        "lockfile",
        "relevantConfig"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "context",
              "graph",
              "protections",
              "binding",
              "identity",
              "release",
              "behavior",
              "vulnerabilities",
              "malware"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "unsupported",
              "not_applicable"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "clear",
              "concern",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "details": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "category",
          "subject",
          "status",
          "coverage",
          "outcome",
          "source",
          "checkedAt",
          "expiresAt",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8192
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "toolVersion",
    "kind",
    "mode",
    "authorization",
    "status",
    "checkedAt",
    "projectRoot",
    "operation",
    "intendedManager",
    "managerSignals",
    "toolchain",
    "protectionMode",
    "settings",
    "registries",
    "cutoff",
    "issues",
    "inputDigests",
    "checks",
    "limitations"
  ],
  "additionalProperties": false
}
