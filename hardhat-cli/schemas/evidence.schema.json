{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hardhat:evidence:1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "review-evidence"
      ]
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "operation": {
      "type": "string",
      "enum": [
        "add",
        "upgrade",
        "compare"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "manager": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "nodeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "arch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "version",
            "nodeVersion",
            "entrypoint",
            "platform",
            "arch"
          ],
          "additionalProperties": false
        },
        "lockfileVersion": {
          "type": "integer",
          "minimum": 0
        },
        "workspaces": {
          "type": "boolean"
        },
        "baseline": {
          "type": "string",
          "enum": [
            "present",
            "new-project",
            "missing"
          ]
        },
        "protectionsMode": {
          "type": "string",
          "enum": [
            "native",
            "manual",
            "unknown"
          ]
        }
      },
      "required": [
        "manager",
        "lockfileVersion",
        "workspaces",
        "baseline",
        "protectionsMode"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockfileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        }
      },
      "required": [
        "manifestDigest",
        "lockfileDigest",
        "configDigest",
        "graphDigest",
        "policyRevision",
        "target"
      ],
      "additionalProperties": false
    },
    "currentBinding": {
      "type": "object",
      "properties": {
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockfileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        }
      },
      "required": [
        "manifestDigest",
        "lockfileDigest",
        "configDigest",
        "graphDigest",
        "policyRevision",
        "target"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "ecosystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "registry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "resolved": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "integrity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "releaseChannel": {
            "type": "string",
            "enum": [
              "stable",
              "prerelease",
              "unknown"
            ]
          },
          "deprecated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "withdrawn": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "support": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "ecosystem",
          "name",
          "version",
          "registry",
          "resolved",
          "integrity",
          "publishedAt",
          "releaseChannel",
          "deprecated",
          "withdrawn",
          "support"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "direct": {
            "type": "boolean"
          },
          "parentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "\\S"
            },
            "maxItems": 10000
          },
          "dependencyType": {
            "type": "string",
            "enum": [
              "runtime",
              "dev",
              "optional",
              "peer"
            ]
          }
        },
        "required": [
          "id",
          "artifactId",
          "path",
          "direct",
          "parentIds",
          "dependencyType"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "context",
              "graph",
              "protections",
              "binding",
              "identity",
              "release",
              "behavior",
              "vulnerabilities",
              "malware"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable",
              "unsupported",
              "not_applicable"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "clear",
              "concern",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "details": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "category",
          "subject",
          "status",
          "coverage",
          "outcome",
          "source",
          "checkedAt",
          "expiresAt",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": [
              "malware",
              "identity",
              "integrity",
              "vulnerability",
              "behavior",
              "release",
              "conflict"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "moderate",
              "low",
              "info",
              "unknown"
            ]
          },
          "confirmation": {
            "type": "string",
            "enum": [
              "verified",
              "suspected"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": [
              "affected",
              "not_affected",
              "unknown"
            ]
          },
          "mitigated": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "artifactId",
          "evidenceId",
          "type",
          "severity",
          "confirmation",
          "applicability",
          "mitigated",
          "description"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "reviewId",
    "operation",
    "project",
    "binding",
    "currentBinding",
    "artifacts",
    "instances",
    "checks",
    "findings"
  ],
  "additionalProperties": false
}
